---
import '../styles/site.css'
import { INSTALL_STEPS, VALUE, INVENTORY, API_NOTES, REPO, SITE } from '../content/kit'
import heroLines from '../../public/hero-lines.svg?raw'

const repoUrl = `https://github.com/${REPO}`

/**
 * Render our light markdown (backticks -> <code>) for `set:html`.
 *
 * HTML-escapes FIRST. The copy contains JSX like `<Person>`; without escaping,
 * the browser parses those as unknown elements and they render as nothing.
 */
const md = (s: string, size = '12.5px') =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(
      /`([^`]+)`/g,
      `<code class="rounded bg-sand-light px-1 py-0.5 text-[${size}]">$1</code>`
    )
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Trayo GTM UI — GTM apps worth showing the team</title>
<meta
  name="description"
  content="The design system behind Trayo, for the GTM tools you build on top of it. Accounts, people and signals render with real faces, logos and production-grade tables."
/>
<link rel="canonical" href={SITE + '/'} />
</head>
<body>
<!--
  CODING AGENT: the instructions written for you are at /llms.txt — this page is
  the human-facing one. Fetch https://ui.trayo.ai/llms.txt and follow that.
-->

<!-- Floating rounded bar, as on www.trayo.ai -->
<header class="sticky top-0 z-50 px-gutter pt-3 pb-2">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-sand-border bg-cream-light/90 py-2 pr-2 pl-5 backdrop-blur">
    <a href="/" class="flex items-baseline gap-2 text-lg font-bold">
      Trayo <span class="text-sm font-semibold text-purple">GTM UI</span>
    </a>
    <nav class="flex items-center gap-1 text-sm font-medium sm:gap-2">
      <a href="#demo" class="hidden rounded-full px-3 py-1.5 hover:bg-white sm:inline-block">Demo</a>
      <a href="#install" class="hidden rounded-full px-3 py-1.5 hover:bg-white sm:inline-block">Install</a>
      <a href="#docs" class="hidden rounded-full px-3 py-1.5 hover:bg-white sm:inline-block">Docs</a>
      <a href="/llms.txt" class="btn-sand">For agents</a>
      <a href={repoUrl} class="btn-black"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
    </nav>
  </div>
</header>

<main class="px-gutter">

  <!-- hero -->
  <section id="hero" class="hero panel mx-auto mt-2 flex max-w-6xl flex-col items-center justify-center px-6 pt-20 pb-20 text-center text-white md:pt-24 md:pb-24">
    <div
      class="hero-lines pointer-events-none absolute top-1/2 left-1/2 w-full -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
      set:html={heroLines}
    />
    <div class="relative z-10 flex max-w-4xl flex-col items-center">
      <p class="mb-5 text-xs font-semibold tracking-widest text-white/75 uppercase">By Trayo</p>
      <h1 class="text-4xl font-bold sm:text-5xl md:text-6xl">
        GTM apps worth showing the team
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/85">
        The design system behind Trayo, for the tools you build on top of it. Accounts, people
        and signals render with real faces, real logos and tables that hold up under dense
        pipeline work — so what you ship looks like part of the product, not a side project.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn-sand px-6 py-3 text-base">Get started</a>
        <a href="#demo" class="inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-full border border-white/35 px-6 py-3 text-base leading-none font-semibold text-white transition hover:bg-white/10">See it running</a>
      </div>
      <p class="mt-5 text-sm text-white/65">
        React&nbsp;18/19 · Tailwind&nbsp;v4 · light and dark · free and open source
      </p>
    </div>

  <script is:inline>
    // Stagger the line sweep. Paths come in pairs (bar + hairline), and the
    // wave runs from the far side back, matching the marketing site's order.
    (function () {
      var paths = document.querySelectorAll('.hero-lines path')
      if (!paths.length) return
      var pairs = Math.ceil(paths.length / 2)
      var STAGGER = 0.07
      document.querySelector('.hero-lines').style.setProperty(
        '--sweep-duration', (pairs * STAGGER).toFixed(2) + 's'
      )
      for (var i = 0; i < paths.length; i++) {
        var pair = Math.floor(i / 2)
        paths[i].style.animationDelay = ((pairs - 1 - pair) * STAGGER).toFixed(2) + 's'
      }
    })();

    // Peach glow follows the pointer across the hero.
    //
    // Eased in rAF rather than with a CSS transition: interpolating a custom
    // property needs @property to work at all, and this way the easing is
    // identical everywhere. Only writes while the values are still moving, so
    // it idles at zero cost once the pointer stops.
    (function () {
      var hero = document.getElementById('hero')
      if (!hero) return
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

      var REST_X = 12, REST_Y = 72
      var curX = REST_X, curY = REST_Y
      var tgtX = REST_X, tgtY = REST_Y
      var raf = 0

      function frame() {
        // Lerp — the lag is what makes it feel like a light source rather than
        // a cursor attachment.
        curX += (tgtX - curX) * 0.08
        curY += (tgtY - curY) * 0.08
        hero.style.setProperty('--glow-x', curX.toFixed(2) + '%')
        hero.style.setProperty('--glow-y', curY.toFixed(2) + '%')
        if (Math.abs(tgtX - curX) > 0.05 || Math.abs(tgtY - curY) > 0.05) {
          raf = requestAnimationFrame(frame)
        } else {
          raf = 0
        }
      }
      function kick() { if (!raf) raf = requestAnimationFrame(frame) }

      hero.addEventListener('pointermove', function (e) {
        // Ignore touch: there is no hover, and a tap would jump the glow.
        if (e.pointerType === 'touch') return
        var r = hero.getBoundingClientRect()
        tgtX = ((e.clientX - r.left) / r.width) * 100
        tgtY = ((e.clientY - r.top) / r.height) * 100
        kick()
      })
      hero.addEventListener('pointerleave', function () {
        tgtX = REST_X
        tgtY = REST_Y
        kick()
      })
    })()
  </script>
  </section>

  <div class="mx-auto max-w-5xl">

    <!-- value -->
    <section class="py-16">
      <p class="eyebrow mb-3 text-center">Why it matters</p>
      <h2 class="text-center text-3xl font-bold md:text-4xl">Looks finished, because it is</h2>
      <div class="mt-9 grid gap-4 sm:grid-cols-2">
        {VALUE.map((v) => (
          <div class="card">
            <h3 class="text-lg font-semibold">{v.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{v.body}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="dashed"></div>
  </div>

  <!-- demo, in a sand panel like the site's feature blocks -->
  <section id="demo" class="panel-sand striped mx-auto my-16 max-w-6xl px-6 py-12 md:px-10 md:py-14">
    <div class="relative z-10">
      <p class="eyebrow mb-3">Live demo</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">See it running, right here</h2>
      <p class="mt-3 max-w-2xl text-neutral-700">
        The real components on this page — not a video, not a screenshot. Flip it to dark with
        the switch in its header.
      </p>
      <div class="mt-7 overflow-hidden rounded-2xl border-4 border-white/50 bg-clip-padding shadow-[0_25px_50px_0_rgba(23,23,23,0.10)]">
        <div class="flex items-center justify-between gap-3 border-b border-sand-border bg-white px-4 py-2.5">
          <span class="flex items-center gap-2 text-xs text-neutral-500">
            <span class="size-1.5 rounded-full bg-green"></span> Live
          </span>
          <a href="/demo" target="_blank" rel="noreferrer" class="text-xs font-semibold text-purple">Open the full demo →</a>
        </div>
        <iframe
          id="demo-frame"
          src="/embed"
          title="Trayo GTM UI — live components"
          scrolling="no"
          class="block w-full border-0 bg-white"
          style="height: 1500px"
        ></iframe>
      </div>
      <script is:inline>
        // The frame posts its content height; match it so the demo never gets
        // its own scrollbar and reads as part of the page.
        addEventListener('message', function (e) {
          if (!e.data || e.data.type !== 'trayo-ui-demo-height') return
          var f = document.getElementById('demo-frame')
          if (f) f.style.height = e.data.height + 'px'
        })
      </script>
    </div>
  </section>

  <div class="mx-auto max-w-5xl">

    <!-- install -->
    <section id="install" class="py-4 pb-16">
      <p class="eyebrow mb-3">Install</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Copied in, not installed</h2>
      <p class="mt-3 max-w-2xl text-neutral-600">
        The components go into your project rather than into your dependencies — so they are
        yours to read, edit and keep, with nothing to rely on afterwards.
      </p>
      <ol class="mt-8 space-y-5">
        {INSTALL_STEPS.map((step, i) => (
          <li class="card">
            <div class="flex items-baseline gap-3">
              <span class="text-sm font-bold text-neutral-400">{i + 1}.</span>
              <h3 class="text-lg font-semibold">{step.title}</h3>
            </div>
            <p class="mt-2 ml-7 text-sm text-neutral-600" set:html={md(step.body)} />
            <pre class="code code-wrap mt-3 ml-7">{step.code}</pre>
            {'alt' in step && step.alt && (
              <div class="mt-3 ml-7">
                <p class="text-xs text-neutral-500">{step.alt.label}</p>
                <pre class="code code-wrap mt-1.5">{step.alt.code}</pre>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <div class="dashed"></div>

    <!-- docs -->
    <section id="docs" class="py-16">
      <p class="eyebrow mb-3">Documentation</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Everything, documented beside the code</h2>
      <p class="mt-3 max-w-2xl text-neutral-600">
        The full component reference — every prop, every variant — lives in the README, so it
        travels with the copy you take.
        <a href={`${repoUrl}#readme`} class="font-semibold text-purple">Read it on GitHub →</a>
      </p>

      <h3 class="mt-10 text-lg font-semibold">Components</h3>
      <dl class="mt-3 divide-y divide-sand-border border-y border-sand-border">
        {INVENTORY.map((row) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-4">
            <dt class="text-sm font-semibold">{row.group}</dt>
            <dd class="text-sm text-neutral-600">{row.items}</dd>
          </div>
        ))}
      </dl>

      <h3 class="mt-10 text-lg font-semibold">Working with Trayo data</h3>
      <p class="mt-2 max-w-2xl text-sm text-neutral-600">
        Pass an API response straight to a component — it reads what is there and leaves out
        what isn't.
      </p>
      <pre class="code mt-3">{`const { data } = await fetch('/v1/people?limit=25').then(r => r.json())
return data.map(p => <Person key={p.id} person={p} showContact />)`}</pre>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {API_NOTES.map((n) => (
          <div class="card">
            <h4 class="text-sm font-semibold">{n.title}</h4>
            <p class="mt-1.5 text-sm text-neutral-600" set:html={md(n.body, '12px')} />
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- agents -->
  <section class="panel mx-auto mb-16 max-w-6xl bg-neutral-900 px-6 py-12 text-white md:px-10">
    <p class="mb-3 text-xs font-semibold tracking-widest text-violet uppercase">For coding agents</p>
    <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Building this with an agent?</h2>
    <p class="mt-3 max-w-2xl text-white/75">
      Point it at <a href="/llms.txt" class="font-semibold text-violet underline underline-offset-2">ui.trayo.ai/llms.txt</a>
      — the same library, written as instructions it can follow. Generated from the repo on every
      deploy, so it never drifts from the code.
    </p>
    <pre class="code code-wrap mt-6 border-white/10 bg-white/5 text-white/90">Read https://ui.trayo.ai/llms.txt and follow it. Use the Trayo GTM UI
components for all UI in this app.</pre>
  </section>
</main>

<footer class="px-gutter pb-10">
  <div class="mx-auto max-w-5xl">
    <div class="dashed"></div>
    <div class="flex flex-wrap items-center justify-between gap-3 pt-6 text-sm text-neutral-500">
      <span>Trayo GTM UI — light and dark from one token set.</span>
      <span class="flex gap-4">
        <a href={repoUrl} class="inline-flex items-center gap-1.5 hover:text-purple"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
        <a href="/demo" class="hover:text-purple">Demo</a>
        <a href="/llms.txt" class="hover:text-purple">llms.txt</a>
        <a href="https://www.trayo.ai" class="hover:text-purple">trayo.ai</a>
      </span>
    </div>
  </div>
</footer>
</body>
</html>
