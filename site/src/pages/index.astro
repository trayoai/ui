---
import '../styles/site.css'
import { INSTALL_STEPS, VALUE, INVENTORY, API_NOTES, REPO, SITE } from '../content/kit'

const repoUrl = `https://github.com/${REPO}`

/**
 * Render our light markdown (backticks -> <code>) for `set:html`.
 *
 * HTML-escapes FIRST. The copy contains JSX like `<Person>`; without escaping,
 * the browser parses those as unknown elements and they render as nothing.
 */
const md = (s: string, size = '12.5px') =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(
      /`([^`]+)`/g,
      `<code class="rounded bg-sand-light px-1 py-0.5 text-[${size}]">$1</code>`
    )
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Trayo GTM UI — the component library for go-to-market apps</title>
<meta
  name="description"
  content="The component library for go-to-market apps, by Trayo. Render Trayo's accounts, people and signals — with real avatars, logos and tables — straight out of the box."
/>
<link rel="canonical" href={SITE + '/'} />
</head>
<body>
<!--
  CODING AGENT: the instructions written for you are at /llms.txt — this page is
  the human-facing one. Fetch https://ui.trayo.ai/llms.txt and follow that.
-->

<header class="sticky top-0 z-50 border-b border-sand-border/70 bg-cream/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-gutter py-3">
    <a href="/" class="flex items-baseline gap-2 font-bold">
      <span class="text-lg">Trayo</span>
      <span class="text-sm font-semibold text-purple">GTM UI</span>
    </a>
    <nav class="flex items-center gap-1 text-sm sm:gap-3">
      <a href="#demo" class="hidden rounded-full px-3 py-1.5 hover:bg-white sm:inline-block">Demo</a>
      <a href="#install" class="hidden rounded-full px-3 py-1.5 hover:bg-white sm:inline-block">Install</a>
      <a href="#docs" class="hidden rounded-full px-3 py-1.5 hover:bg-white sm:inline-block">Docs</a>
      <a href={repoUrl} class="btn-primary">GitHub</a>
    </nav>
  </div>
</header>

<main class="mx-auto max-w-5xl px-gutter">

  <!-- hero -->
  <section class="pt-14 pb-12 sm:pt-20">
    <p class="eyebrow mb-3">Component library</p>
    <h1 class="max-w-4xl text-4xl font-bold sm:text-5xl md:text-6xl">
      The leading component library for GTM apps,
      <span class="bg-gradient-to-br from-sand via-peach to-purple bg-clip-text text-transparent">by Trayo</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-neutral-600">
      Everything you need to put Trayo's data on screen. Accounts, people, buying signals and
      job changes arrive as React components that already know their shape — with real avatars,
      real company logos and tables built for dense pipeline work.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="#demo" class="btn-primary">See it running</a>
      <a href="#install" class="btn-ghost">Install</a>
    </div>
    <p class="mt-5 text-sm text-neutral-500">
      React&nbsp;18/19 · Tailwind&nbsp;v4 · light and dark · free and open source
    </p>
  </section>

  <!-- value -->
  <section class="mb-16 grid gap-4 sm:grid-cols-2">
    {VALUE.map((v) => (
      <div class="card">
        <h2 class="text-lg font-semibold">{v.title}</h2>
        <p class="mt-2 text-sm text-neutral-600">{v.body}</p>
      </div>
    ))}
  </section>

  <!-- demo -->
  <section id="demo" class="mb-16">
    <h2 class="text-3xl font-bold">See it running</h2>
    <p class="mt-2 max-w-2xl text-neutral-600">
      The real components, live on this page — not a video, not a picture. Flip it to dark with
      the switch in its header.
    </p>
    <div class="mt-5 overflow-hidden rounded-2xl border border-sand-border bg-white shadow-[0_10px_30px_-18px_rgba(60,40,20,0.35)]">
      <div class="flex items-center justify-between gap-3 border-b border-sand-border px-4 py-2.5">
        <span class="flex items-center gap-2 text-xs text-neutral-500">
          <span class="size-1.5 rounded-full bg-green"></span> Live
        </span>
        <a href="/demo" target="_blank" rel="noreferrer" class="text-xs font-semibold text-purple">Open full size →</a>
      </div>
      <iframe src="/demo" title="Trayo GTM UI — live component demo" loading="lazy" class="block h-[820px] w-full border-0"></iframe>
    </div>
  </section>

  <!-- install -->
  <section id="install" class="mb-16">
    <h2 class="text-3xl font-bold">Install</h2>
    <p class="mt-2 max-w-2xl text-neutral-600">
      The components are copied into your project rather than installed as a package — so they
      are yours to read, edit and keep, with nothing to depend on afterwards.
    </p>
    <ol class="mt-6 space-y-6">
      {INSTALL_STEPS.map((step, i) => (
        <li class="card">
          <div class="flex items-baseline gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-purple text-xs font-bold text-white">{i + 1}</span>
            <h3 class="text-lg font-semibold">{step.title}</h3>
          </div>
          <p class="mt-2 ml-9 text-sm text-neutral-600" set:html={md(step.body)} />
          <pre class="code code-wrap mt-3 ml-9">{step.code}</pre>
          {'alt' in step && step.alt && (
            <div class="mt-3 ml-9">
              <p class="text-xs text-neutral-500">{step.alt.label}</p>
              <pre class="code code-wrap mt-1.5">{step.alt.code}</pre>
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- docs -->
  <section id="docs" class="mb-16">
    <h2 class="text-3xl font-bold">Documentation</h2>
    <p class="mt-2 max-w-2xl text-neutral-600">
      The full component reference — every prop, every variant — lives in the README beside the
      code, so it travels with the copy you take.
      <a href={`${repoUrl}#readme`} class="font-semibold text-purple">Read it on GitHub →</a>
    </p>

    <h3 class="mt-8 text-lg font-semibold">Components</h3>
    <dl class="mt-3 divide-y divide-sand-border border-y border-sand-border">
      {INVENTORY.map((row) => (
        <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-4">
          <dt class="text-sm font-semibold">{row.group}</dt>
          <dd class="text-sm text-neutral-600">{row.items}</dd>
        </div>
      ))}
    </dl>

    <h3 class="mt-8 text-lg font-semibold">Working with Trayo data</h3>
    <p class="mt-2 max-w-2xl text-sm text-neutral-600">
      Pass an API response straight to a component — it reads what is there and leaves out what
      isn't.
    </p>
    <pre class="code mt-3">{`const { data } = await fetch('/v1/people?limit=25').then(r => r.json())
return data.map(p => <Person key={p.id} person={p} showContact />)`}</pre>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {API_NOTES.map((n) => (
        <div class="card">
          <h4 class="text-sm font-semibold">{n.title}</h4>
          <p class="mt-1.5 text-sm text-neutral-600" set:html={md(n.body, '12px')} />
        </div>
      ))}
    </div>
  </section>

  <!-- agents -->
  <section class="mb-16">
    <div class="rounded-2xl border border-purple/25 bg-purple/[0.06] p-5 sm:p-6">
      <h2 class="text-lg font-semibold">Building with a coding agent?</h2>
      <p class="mt-2 max-w-3xl text-sm text-neutral-700">
        Point it at <a href="/llms.txt" class="font-semibold text-purple underline underline-offset-2">ui.trayo.ai/llms.txt</a>
        — the same library, written as instructions it can follow. Generated from the repo on
        every deploy, so it never drifts from the code.
      </p>
      <pre class="code code-wrap mt-4">Read https://ui.trayo.ai/llms.txt and follow it. Use the Trayo GTM UI
components for all UI in this app.</pre>
    </div>
  </section>
</main>

<footer class="border-t border-sand-border">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-gutter py-6 text-sm text-neutral-500">
    <span>Trayo GTM UI — light and dark from one token set.</span>
    <span class="flex gap-4">
      <a href={repoUrl} class="hover:text-purple">GitHub</a>
      <a href="/demo" class="hover:text-purple">Demo</a>
      <a href="/llms.txt" class="hover:text-purple">llms.txt</a>
      <a href="https://www.trayo.ai" class="hover:text-purple">trayo.ai</a>
    </span>
  </div>
</footer>
</body>
</html>
