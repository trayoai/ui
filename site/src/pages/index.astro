---
import '../styles/site.css'
import { INSTALL_STEPS, VALUE, INVENTORY, API_NOTES, REPO, SITE } from '../content/kit'
import Logo from '../assets/trayo-logo.svg'

const repoUrl = `https://github.com/${REPO}`

// Markup for the Copy button on a code box. Place it inside a `relative`
// wrapper beside a <pre><code>; the script at the end of the page copies that
// <code>'s text. Give the <pre> `pr-24` so long lines wrap before the button.
const copyButton = `<button type="button" class="absolute top-3 right-3 flex cursor-pointer items-center gap-1.5 rounded-lg border border-sand-border bg-cream-light px-2.5 py-1.5 text-xs font-medium text-neutral-600 transition-colors hover:border-purple hover:text-neutral-900" aria-label="Copy code to clipboard" data-copy-btn><svg data-copy-icon class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><svg data-check-icon class="hidden size-3.5 text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span data-copy-label>Copy</span></button>`

// Inner SVG markup for the VALUE cards, keyed by each entry's `icon` in kit.ts.
const VALUE_ICONS: Record<string, string> = {
  palette:
    '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.65-.75 1.65-1.69 0-.44-.18-.84-.44-1.13-.29-.29-.44-.65-.44-1.13a1.64 1.64 0 0 1 1.67-1.67h2c3.05 0 5.56-2.5 5.56-5.55C21.97 6.01 17.46 2 12 2z"/>',
  eye: '<path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0"/><circle cx="12" cy="12" r="3"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9.5 12l2 2 3.5-4"/>',
  layers:
    '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
}

/**
 * Render our light markdown (backticks -> <code>) for `set:html`.
 *
 * HTML-escapes FIRST. The copy contains JSX like `<Person>`; without escaping,
 * the browser parses those as unknown elements and they render as nothing.
 */
const md = (s: string, size = '12.5px') =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(
      /`([^`]+)`/g,
      `<code class="rounded bg-sand-light/50 px-1 py-0.5 text-[${size}] text-neutral-800">$1</code>`
    )
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Trayo GTM UI — GTM apps worth showing the team</title>
<meta
  name="description"
  content="The design system behind Trayo, for the GTM tools you build on top of it. Accounts, people and signals render with real faces, logos and production-grade tables."
/>
<link rel="canonical" href={SITE + '/'} />
</head>
<body>
<!--
  CODING AGENT: the instructions written for you are at /llms.txt — this page is
  the human-facing one. Fetch https://ui.trayo.ai/llms.txt and follow that.
-->

<header class="site-header fixed inset-x-0 top-0 z-50 lg:px-8 lg:py-2" data-header>
  <div class="mx-auto max-w-6xl">
    <div class="site-header-bar flex items-center gap-8 bg-cream px-gutter py-3 text-neutral-900 lg:rounded-full lg:px-6 lg:py-4">
      <div class="mr-auto flex shrink-0 items-center gap-3">
        <a href="/" class="text-neutral-900 transition hover:text-purple" aria-label="Trayo GTM UI — home">
          <Logo class="h-7 w-auto" aria-hidden="true" />
        </a>
        <span class="hidden h-4 w-px bg-sand-border sm:block" aria-hidden="true"></span>
        <span class="hidden text-sm font-semibold tracking-[1px] whitespace-nowrap text-neutral-900 sm:block">GTM UI</span>
      </div>
      <nav class="flex items-center gap-8" aria-label="Main">
        <ul class="hidden items-center gap-8 lg:flex">
          <li><a href="#demo" class="transition-colors hover:text-purple">Demo</a></li>
          <li><a href="#install" class="transition-colors hover:text-purple">Install</a></li>
          <li><a href="#docs" class="transition-colors hover:text-purple">Docs</a></li>
        </ul>
        <div class="flex items-center gap-2">
          <a href="/llms.txt" class="btn-sand whitespace-nowrap">For agents</a>
          <a href={repoUrl} class="btn-black" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg><span class="hidden sm:inline">GitHub</span></a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  // Adds a shadow once the page scrolls. Below lg, also hides the header on
  // scroll-down and brings it back on scroll-up; desktop keeps it pinned.
  (function () {
    var header = document.querySelector('[data-header]')
    if (!header) return
    var desktop = matchMedia('(min-width: 1024px)')
    var DEADZONE = 8
    var lastY = scrollY
    var ticking = false

    function update() {
      ticking = false
      var y = scrollY
      header.classList.toggle('is-scrolled', y > 2)
      if (desktop.matches || y <= header.offsetHeight) {
        header.classList.remove('is-hidden')
        lastY = y
        return
      }
      if (Math.abs(y - lastY) >= DEADZONE) {
        header.classList.toggle('is-hidden', y > lastY)
        lastY = y
      }
    }
    addEventListener('scroll', function () {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }, { passive: true })
    update()
  })()
</script>

<main class="px-gutter pt-(--header-offset)">

  <!-- hero -->
  <section id="hero" class="hero panel mx-auto mt-2 flex max-w-6xl flex-col items-center justify-center py-10 text-white">
    <img src="/Ellipse1.svg" alt="" aria-hidden="true" class="hero-ellipse pointer-events-none absolute top-[-30%] left-1/2 z-0 w-[90%] max-w-none -translate-x-1/2 sm:w-[70%]" />
    <img src="/Ellipse2.svg" alt="" aria-hidden="true" class="hero-ellipse hero-ellipse--2 pointer-events-none absolute top-[-16%] left-[42%] z-0 w-[70%] max-w-none -translate-x-1/2 sm:w-[55%]" />
    <img src="/Ellipse3.svg" alt="" aria-hidden="true" class="hero-ellipse hero-ellipse--3 pointer-events-none absolute top-[-23%] left-[58%] z-0 w-[95%] max-w-none -translate-x-1/2 sm:w-[75%]" />
    <div class="hero-noise" aria-hidden="true"></div>
    <div class="hero-lines" aria-hidden="true"></div>
    <div class="relative z-10 flex max-w-240 flex-col items-start px-gutter sm:items-center sm:text-center">
      <p class="hero-eyebrow hero-in relative mb-5 inline-block rounded-full bg-cream px-3 text-xs font-semibold tracking-[1px] text-neutral-900 uppercase">
        By Trayo
      </p>
      <h1 class="hero-in relative mb-5 text-4xl font-bold text-balance sm:text-6xl md:text-7xl">
        GTM apps worth showing the team
      </h1>
      <p class="hero-in hero-in-2 relative max-w-2xl text-lg">
        The design system behind Trayo, for the tools you build on top of it. Accounts, people
        and signals render with real faces, real logos and tables that hold up under dense
        pipeline work — so what you ship looks like part of the product, not a side project.
      </p>
      <div class="hero-in hero-in-3 relative mt-7 flex flex-wrap items-center gap-3 sm:justify-center">
        <a href="#install" class="hero-cta group">
          <span class="relative inline-flex items-center justify-center overflow-hidden">
            <span class="hero-cta-text relative inline-flex group-hover:-translate-y-full group-focus-visible:-translate-y-full">Get started</span>
            <span class="hero-cta-text absolute inset-0 inline-flex translate-y-full items-center justify-center group-hover:translate-y-0 group-focus-visible:translate-y-0" aria-hidden="true">Get started</span>
          </span>
        </a>
        <a href="#demo" class="hero-cta-outline group">
          <span class="relative inline-flex items-center justify-center overflow-hidden">
            <span class="hero-cta-text hero-cta-text--outline relative inline-flex group-hover:-translate-y-full group-focus-visible:-translate-y-full">See it running</span>
            <span class="hero-cta-text hero-cta-text--outline absolute inset-0 inline-flex translate-y-full items-center justify-center group-hover:translate-y-0 group-focus-visible:translate-y-0" aria-hidden="true">See it running</span>
          </span>
        </a>
      </div>
      <p class="hero-in hero-in-3 relative mt-5 text-sm text-white/70">
        React&nbsp;18/19 · Tailwind&nbsp;v4 · light and dark · free and open source
      </p>
    </div>

  </section>

  <div class="mx-auto max-w-5xl">

    <!-- value -->
    <section class="py-16">
      <p class="eyebrow mb-3 text-center">Why it matters</p>
      <h2 class="text-center text-3xl font-bold md:text-4xl">Looks finished, because it is</h2>
      <div class="mt-9 grid grid-cols-1 divide-y divide-sand-border rounded-2xl border border-sand-border bg-white sm:grid-cols-2 sm:divide-y-0">
        {/* Hairlines between cells: stacked rows use divide-y; in the 2-column grid the
            second row gets a top border and the right column a left border. */}
        {VALUE.map((v, i) => (
          <div class:list={['p-5', i >= 2 && 'sm:border-t sm:border-sand-border', i % 2 === 1 && 'sm:border-l sm:border-sand-border']}>
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-sand-border p-2 text-purple" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={VALUE_ICONS[v.icon]} />
            </span>
            <h3 class="mt-4 font-semibold text-neutral-900">{v.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-neutral-500">{v.body}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- demo, in a sand panel like the site's feature blocks -->
  <section id="demo" class="panel-sand sand-texture mx-auto my-16 max-w-6xl px-6 py-12 md:px-10 md:py-14">
    <div class="relative z-10">
      <p class="eyebrow mb-3">Live demo</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">See it running, right here</h2>
      <p class="mt-3 max-w-2xl text-neutral-700">
        The real components on this page — not a video, not a screenshot. Flip it to dark with
        the switch in its header.
      </p>
      <div class="mt-7 overflow-hidden rounded-2xl border-4 border-white/50 bg-clip-padding shadow-[0_25px_50px_0_rgba(23,23,23,0.10)]">
        <div class="flex items-center justify-between gap-3 border-b border-sand-border bg-white px-4 py-2.5">
          <span class="flex items-center gap-2 text-xs text-neutral-500">
            <span class="size-1.5 rounded-full bg-green"></span> Live
          </span>
          <a href="/demo" target="_blank" rel="noreferrer" class="text-xs font-semibold text-purple">Open the full demo →</a>
        </div>
        <iframe
          id="demo-frame"
          src="/embed"
          title="Trayo GTM UI — live components"
          scrolling="no"
          class="block w-full border-0 bg-white"
          style="height: 1500px"
        ></iframe>
      </div>
      <script is:inline>
        // The frame posts its content height; match it so the demo never gets
        // its own scrollbar and reads as part of the page.
        addEventListener('message', function (e) {
          if (!e.data || e.data.type !== 'trayo-ui-demo-height') return
          var f = document.getElementById('demo-frame')
          if (f) f.style.height = e.data.height + 'px'
        })
      </script>
    </div>
  </section>

  <!-- install -->
  <!-- The dashed outline is an SVG rect, not a CSS border: CSS can't set the
       dash length, and this matches the 2px-dash / 8px-gap rhythm of .dashed. -->
    <section id="install" class="relative mx-auto mt-4 mb-16 max-w-6xl overflow-hidden rounded-3xl px-6 py-12 md:px-10 md:py-14">
      <svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true">
        <rect x="0.5" y="0.5" width="calc(100% - 1px)" height="calc(100% - 1px)" rx="23.5" ry="23.5" fill="none" stroke="rgb(138 138 138)" stroke-width="1" stroke-dasharray="2 8" />
      </svg>
      <div class="relative z-10">
      <p class="eyebrow mb-3">Install</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Copied in, not installed</h2>
      <p class="mt-3 max-w-2xl text-neutral-600">
        The components go into your project rather than into your dependencies — so they are
        yours to read, edit and keep, with nothing to rely on afterwards.
      </p>
      <ol class="mt-8 space-y-5">
        {INSTALL_STEPS.map((step, i) => (
          <li class="rounded-2xl bg-cream-light p-5">
            <h3 class="flex items-baseline gap-2 text-lg font-semibold">
              <span class="text-neutral-400">{i + 1}.</span>
              {step.title}
            </h3>
            <p class="mt-2 text-sm text-neutral-600" set:html={md(step.body)} />
            <div class="relative mt-3" data-copy-block>
              <Fragment set:html={copyButton} />
              <pre class="code code-wrap pr-24"><code>{step.code}</code></pre>
            </div>
            {'alt' in step && step.alt && (
              <div class="mt-4">
                <p class="text-sm text-neutral-600">{step.alt.label}</p>
                <div class="relative mt-3" data-copy-block>
                  <Fragment set:html={copyButton} />
                  <pre class="code code-wrap pr-24"><code>{step.alt.code}</code></pre>
                </div>
              </div>
            )}
          </li>
        ))}
      </ol>
      </div>
    </section>

  <section id="docs" class="relative mx-auto mb-16 max-w-6xl overflow-hidden rounded-3xl px-6 py-12 md:px-10 md:py-14">
    <svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true">
      <rect x="0.5" y="0.5" width="calc(100% - 1px)" height="calc(100% - 1px)" rx="23.5" ry="23.5" fill="none" stroke="rgb(138 138 138)" stroke-width="1" stroke-dasharray="2 8" />
    </svg>
    <div class="relative z-10">
      <p class="eyebrow mb-3">Documentation</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Everything, documented beside the code</h2>
      <p class="mt-3 max-w-2xl text-neutral-600">
        The full component reference — every prop, every variant — lives in the README, so it
        travels with the copy you take.
        <a href={`${repoUrl}#readme`} class="font-semibold text-purple">Read it on GitHub →</a>
      </p>

      <h3 class="mt-10 text-lg font-semibold">Components</h3>
      <dl class="mt-3 divide-y divide-sand-border border-y border-sand-border">
        {INVENTORY.map((row) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[180px_1fr] sm:gap-4">
            <dt class="text-sm font-semibold">{row.group}</dt>
            <dd class="text-sm text-neutral-600">{row.items}</dd>
          </div>
        ))}
      </dl>

      <h3 class="mt-10 text-lg font-semibold">Working with Trayo data</h3>
      <p class="mt-2 max-w-2xl text-sm text-neutral-600">
        Pass an API response straight to a component — it reads what is there and leaves out
        what isn't.
      </p>
      <div class="relative mt-3" data-copy-block>
        <Fragment set:html={copyButton} />
        <pre class="code pr-24"><code>{`const { data } = await fetch('/v1/people?limit=25').then(r => r.json())
return data.map(p => <Person key={p.id} person={p} showContact />)`}</code></pre>
      </div>
      <div class="mt-4 grid gap-4">
        {API_NOTES.map((n) => (
          <div class="card">
            <h4 class="text-sm font-semibold">{n.title}</h4>
            <p class="mt-1.5 text-sm text-neutral-600" set:html={md(n.body, '12px')} />
          </div>
        ))}
      </div>
    </div>
    </section>

  <section class="panel-sand sand-texture mx-auto mb-16 max-w-5xl px-6 py-12 md:px-10 md:py-14">
    <div class="relative z-10">
      <p class="eyebrow mb-3">For coding agents</p>
      <h2 class="max-w-2xl text-3xl font-bold md:text-4xl">Building this with an agent?</h2>
      <p class="mt-3 max-w-2xl text-neutral-700">
        Point it at <a href="/llms.txt" class="font-semibold text-purple">ui.trayo.ai/llms.txt</a>
        — the same library, written as instructions it can follow. Generated from the repo on every
        deploy, so it never drifts from the code.
      </p>
      <div class="relative mt-6" data-copy-block>
        <Fragment set:html={copyButton} />
        <pre class="code code-wrap pr-24"><code>Read https://ui.trayo.ai/llms.txt and follow it. Use the Trayo GTM UI
components for all UI in this app.</code></pre>
      </div>
    </div>
  </section>
</main>

<footer class="px-gutter pb-gutter">
  <div class="mx-auto max-w-6xl rounded-3xl bg-neutral-900 px-6 py-12 lg:px-16">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
      <p class="text-base text-neutral-200">Trayo · GTM UI — light and dark from one token set.</p>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-base text-neutral-200">
          <li><a href={repoUrl} class="inline-flex items-center gap-1.5 hover:text-white"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a></li>
          <li><a href="/demo" class="hover:text-white">Demo</a></li>
          <li><a href="/llms.txt" class="hover:text-white">llms.txt</a></li>
          <li><a href="https://www.trayo.ai" class="hover:text-white">trayo.ai</a></li>
        </ul>
      </nav>
    </div>
    <div class="dashed mt-10"></div>
    <div class="flex items-center justify-between gap-4 pt-8 text-sm text-neutral-400">
      <p>&copy; Trayo</p>
      <a href="#" class="inline-flex items-center gap-1.5 hover:text-neutral-200">
        Back to top
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
      </a>
    </div>
  </div>
</footer>
  <script is:inline>
    // Wires up every Copy button (see copyButton above). It sits at the end of
    // the page so all code boxes exist when it runs.
    document.querySelectorAll('[data-copy-btn]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.parentElement.querySelector('code')
        if (!code || !navigator.clipboard) return
        navigator.clipboard.writeText(code.textContent).then(function () {
          var icon = btn.querySelector('[data-copy-icon]')
          var check = btn.querySelector('[data-check-icon]')
          var label = btn.querySelector('[data-copy-label]')
          icon.classList.add('hidden')
          check.classList.remove('hidden')
          label.textContent = 'Copied'
          clearTimeout(btn._reset)
          btn._reset = setTimeout(function () {
            icon.classList.remove('hidden')
            check.classList.add('hidden')
            label.textContent = 'Copy'
          }, 2000)
        })
      })
    })
  </script>
</body>
</html>
